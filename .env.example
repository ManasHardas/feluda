# Copy to backend/.env for local development. Placeholder values only: never commit real values.
# Staging and production get these from the hosting provider's secret store (see docs/DEPLOYMENT.md).

ENVIRONMENT=development            # development | test | staging | production
DATABASE_URL=postgresql://watchdog:watchdog_local_dev_only@localhost:54329/watchdog
DATABASE_POOL_MAX=5

# --- Administration. There is no resident sign-in: phones are enrolled with invitation links.
ADMIN_API_TOKEN=local-development-admin-token-not-for-production   # operator secret, min 32 chars; empty disables /api/v1/admin

# --- Public URLs shown to residents
PUBLIC_BASE_URL=http://localhost:8000
ANDROID_INSTALL_URL=               # Firebase App Distribution invite link
IOS_INSTALL_URL=                   # TestFlight public or invite link
SOURCE_REPO_URL=
SUPPORT_URL=
SECURITY_CONTACT=

# --- Push notifications (leave empty to run without push; deliveries are then recorded as not configured)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=          # the whole service-account JSON on one line
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=                  # contents of AuthKey_XXXX.p8
APNS_BUNDLE_ID=app.feluda

# --- Operations
BACKGROUND_WORKER_ENABLED=true
TICK_INTERVAL_SECONDS=20
TRUST_PROXY_HEADERS=false          # true only behind a proxy that sets X-Forwarded-For
IP_HASH_SALT=change-me             # random string; required in staging/production
SENTRY_DSN=
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=
